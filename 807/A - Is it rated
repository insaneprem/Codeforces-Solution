#include <bits/stdc++.h>
using namespace std;
#define int long long
#define ld long double
void solve()
{
    int n;
    cin >> n;
 
    int deltachange = 0;
    bool isdec = 1;
    int backperson = 1e9;
    while (n--)
    {
        int prev, curr;
        cin >> prev >> curr;
 
        deltachange = max(deltachange, abs(prev - curr));
 
        if (prev > backperson)
            isdec = 0;
 
        backperson = prev;
    }
 
    if (deltachange != 0)
        cout << "rated";
    else if (deltachange == 0 && !isdec)
        cout << "unrated";
    else
        cout << "maybe";
}
