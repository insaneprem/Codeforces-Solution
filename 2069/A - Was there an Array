#include <bits/stdc++.h>
using namespace std;
#define int long long
#define ld long double
void solve()
{
  int n;
  cin >> n;
 
  vector<int> arr(n-2);
  for (auto &i : arr)
    cin >> i;
 
  for (int i = 1; i < n - 3; i++)
  {
    if (arr[i - 1] == 1 && arr[i] == 0 && arr[i + 1] == 1)
    {
      cout << "NO";
      return;
    }
  }
 
  cout << "YES";
}
