#include <bits/stdc++.h>
using namespace std;
#define int long long
#define ld long double
typedef pair<int, int> P;
void dijkstra(int src, vector<P> adj[], vector<int> &dist, vector<int> &parent)
{
    priority_queue<P, vector<P>, greater<P>> pq;
    pq.push({0, src});
    dist[src] = 0;
 
    while (!pq.empty())
    {
        int u = pq.top().second;
        int dist_so_far = pq.top().first;
        pq.pop();
 
        if (dist_so_far > dist[u])
            continue;
 
        for (auto e : adj[u])
        {
            int v = e.first;
            int w = e.second;
 
            if (dist[v] > w + dist_so_far)
            {
                dist[v] = w + dist_so_far;
                parent[v] = u;
                pq.push({dist[v], v});
            }
        }
    }
}
void pathtrace(vector<int> &parent)
{
    vector<int> nodes;
    int currnode = parent.size() - 1;
 
    while (currnode != 1)
    {
        nodes.push_back(currnode);
        currnode = parent[currnode];
    }
 
    nodes.push_back(1);
    reverse(begin(nodes), end(nodes));
 
    for (auto i : nodes)
        cout << i << " ";
}
void solve()
{
    int n, m;
    cin >> n >> m;
 
    vector<pair<int, int>> adj[n + 1];
 
    for (int i = 0; i < m; i++)
    {
        int u, v, w;
        cin >> u >> v >> w;
 
        adj[u].push_back({v, w});
        adj[v].push_back({u, w});
    }
 
    vector<int> parent(n + 1, -1);
    vector<int> dist(n + 1, 1e17);
    dijkstra(1, adj, dist, parent);
 
    if (dist[n] == 1e17)
    {
        cout << -1;
        return;
    }
 
    pathtrace(parent);
}
